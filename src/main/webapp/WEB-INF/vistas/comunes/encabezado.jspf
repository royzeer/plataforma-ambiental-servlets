<%-- Encabezado común. Se incluye con la directiva <%@ include %> (se copia al compilar la JSP) --%>
<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%-- Formato colombiano para números (1.000.000) --%>
<fmt:setLocale value="es_CO" scope="request"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Plataforma Ambiental | Proyectos</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css">
</head>
<body>
<header class="barra">
    <a class="marca" href="${pageContext.request.contextPath}/proyectos">
        <span class="hoja">&#127807;</span> Plataforma Ambiental
    </a>
    <nav>
        <a href="${pageContext.request.contextPath}/proyectos">Proyectos</a>
        <a href="${pageContext.request.contextPath}/proyectos?accion=nuevo">Nuevo proyecto</a>
    </nav>
</header>
<main class="contenedor">
    <c:if test="${not empty mensajeExito}">
        <div class="alerta exito" role="status"><c:out value="${mensajeExito}"/></div>
    </c:if>
    <c:if test="${not empty mensajeError}">
        <div class="alerta error" role="alert"><c:out value="${mensajeError}"/></div>
    </c:if>
